VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# There is no service_role variable here on purpose. This is a browser app —
# a leaked service_role key bypasses every RLS policy in the database.
# Every mutation this app makes goes through RLS with the anon key, same as
# eternity-web. If a feature seems to need service_role, it needs an RLS
# policy instead.
